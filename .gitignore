tests/load_source.R
tests/run_bench.bat
tests/l3_urls.txt

# Database Files
*.duckdb
*.duckdb.wal
.positai

# agent-workflow/dashboard (Streamlit) -- app.py, requirements.txt and
# agents-board.json ARE tracked (shared coordination layer); local Python
# cache/venv/config are not.
agent-workflow/dashboard/__pycache__/
agent-workflow/dashboard/*.pyc
agent-workflow/dashboard/.venv/
.streamlit/

# Training folder: only the notebook source is tracked. Data, downloads, images,
# rendered output, setup scripts and participant documents stay local.
training/*
!training/water-productivity-training.qmd

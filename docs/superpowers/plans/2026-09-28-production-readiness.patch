+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/wapor_map.R
+\name{wapor_unstack_map}
+\alias{wapor_unstack_map}
+\title{Split a multi-band wapor_map() stack into one file per date}
+\usage{
+wapor_unstack_map(
+  path,
+  folder = dirname(path),
+  overwrite = FALSE,
+  remove_stack = FALSE
+)
+}
+\arguments{
+\item{path}{Character. Path to the multi-band GeoTIFF.}
+
+\item{folder}{Character. Output folder. Defaults to the stack's folder.}
+
+\item{overwrite}{Logical. Overwrite existing per-date files. Default \code{FALSE}.}
+
+\item{remove_stack}{Logical. Delete the stack after a successful split, so
+local readers do not see both. Default \code{FALSE}.}
+}
+\value{
+Character vector of per-date file paths, invisibly.
+}
+\description{
+\code{wapor_map(separate_files = FALSE)} (the default) writes one multi-band
+GeoTIFF named \verb{<product>.<first date>_<last date>.tif}, with one band per
+time step named by its start date. Local analysis
+(\code{data_source = "local"}) needs one file per time step. This writes
+\verb{<product>.<date>.tif} next to the stack (or into \code{folder}), the same layout
+as \code{wapor_map(separate_files = TRUE)}, and skips files that already exist.
+}
+\examples{
+\dontrun{
+stack <- wapor_map(c(35, 33, 36, 34), "L1-AETI-D",
+                   c("2023-01-01", "2023-03-31"), folder = "wapor_data")
+wapor_unstack_map(stack)
+}
+}
